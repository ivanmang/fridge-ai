# Copy to `.env` for local `npm run dev` / `npm run build`.
# On Vercel, set the same keys in Project → Settings → Environment Variables.

# Required for Identify (photo → food names) and online dish lookup.
# Inventory, home recipes, shopping list, and manual add work without it.
# Never expose this in the browser or commit it.
XAI_API_KEY=

# FridgeAI does not use accounts or a shared DB. Keep auth off for public deploys.
# vite.config already builds with Nitro's Vercel preset; vercel.json sets this too.
VITE_AUTH_ENABLED=false

# Optional. Only needed if you enable Better Auth / Postgres yourself.
# Leave unset so build skips migrate and the unused PGLite path stays local-only.
# DATABASE_URL=
